# Copy to .env and fill in locally. Never commit real values.
# Workspace rule: no hardcoded credentials in source.
#
# Both SaaS and on-prem blocks may be filled at once. The Chainlit checkboxes
# pick where each turn is sent (one, the other, or both).

# --- Splunk Agent Observability (SaaS) ---
# SPLUNK_AO_REALM=us1
# SPLUNK_AO_O11Y_TOKEN=
# SPLUNK_AO_O11Y_API_TOKEN=

# --- Splunk Agent Observability (on-prem / standalone / custom) ---
# SPLUNK_AO_API_KEY=
# SPLUNK_AO_CONSOLE_URL=https://console.example.internal

# Optional. Comma-separated: saas, onprem. Defaults to every destination that
# has credentials. Used for seed_traces.py and the initial checkbox state.
# SAO_DEFAULT_DESTINATIONS=saas,onprem

# Project + Agent Stream (both deployments)
SPLUNK_AO_PROJECT=AussieCare
SPLUNK_AO_AGENT_STREAM=webinar-live

# --- LLM ---
OPENAI_API_KEY=
# OPENAI_BASE_URL=
MODEL_NAME=gpt-4o

# Optional: pick which provider is used first when more than one is configured.
# DEFAULT_MODEL_PROVIDER=openai

# --- Amazon Bedrock (optional alternative provider) ---
# Configured when AWS_REGION is set and either AWS_PROFILE or both
# AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY are set. When both OpenAI and
# Bedrock are configured, a "Model provider" selector appears in settings.
# AWS_PROFILE=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Optional OpenTelemetry service name in Splunk APM
OTEL_SERVICE_NAME=aussiecare-copilot

# Chainlit listens on 8000 unless you pass --port or set this *before* `chainlit run`.
# Prefer: ./scripts/run_ui.sh  (defaults to 8081)
# CHAINLIT_PORT=8081
